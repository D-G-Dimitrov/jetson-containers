+        bf16_vals = tl.load(bf16_src + chunk_offsets)
+        bf16_vals = tl.where(is_in_range, bf16_vals, tl.zeros_like(bf16_vals))
+        tl.store(out_bf16 + chunk_offsets, bf16_vals)
